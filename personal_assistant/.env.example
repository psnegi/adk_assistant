# ──────────────────────────────────────────────────────────────
# ADK Personal Assistant — Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Option A: Google AI Studio (free Gemini API key) ─────────
# Get a free key at https://aistudio.google.com/apikey
# When using this option, set GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-gemini-api-key-here

# ── Option B: Vertex AI (GCP project) ───────────────────────
# Uncomment the lines below and comment out Option A above.
# Requires: gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-east4

# ── Option C: Local Ollama model ─────────────────────────────
# Run a model locally with Ollama (https://ollama.com).
# Set USE_OLLAMA=true and comment out Options A and B above.
# Pull a model first:  ollama pull llama3.2
# USE_OLLAMA=true
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── YouTube Data API v3 ─────────────────────────────────────
# Get a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key-here

# ── Gmail OAuth token path ───────────────────────────────────
GMAIL_TOKEN_FILE=token.json

# ── Option C: Local Ollama (no cloud API key required) ──────────────────────
# Install Ollama: https://ollama.com/download  →  then run `ollama serve`
# Set USE_OLLAMA=true to route all requests through a local Ollama instance.
# The agent will automatically pull the model on first run if it is missing.
# USE_OLLAMA=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Agent model (optional) ───────────────────────────────────
# Used only when USE_OLLAMA=false (Options A / B above).
# AGENT_MODEL=gemini-2.0-flash-001
